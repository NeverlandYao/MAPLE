MS_API_KEY=your_models_provider_api_key
MS_BASE_URL=https://api.siliconflow.cn/v1
MS_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# Optional Google fallback (OpenAI-compatible endpoint)
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GOOGLE_MODEL=gemini-2.0-flash

# LLM routing & resilience
# LLM_PRIMARY=ms              # which provider goes first: ms | google (default: ms)
# LLM_PROVIDER_RETRIES=2      # retries per provider before moving to next (default: 2)
# LLM_TIMEOUT_SECONDS=18      # per-request read timeout (default: 18)
# LLM_CONNECT_TIMEOUT_SECONDS=5  # connect timeout — fail fast for unreachable hosts (default: 5)
# LLM_RETRY_BASE_MS=300       # base backoff ms between retries (default: 300, doubles each retry)
# LLM_DEGRADED_THRESHOLD=3    # consecutive failures before a provider is deprioritised (default: 3)
# LLM_RECOVERY_SECONDS=60     # seconds until a degraded provider is auto-recovered (default: 60)
# LLM_PROXY=http://127.0.0.1:7897  # explicit HTTP proxy for all LLM calls (optional)

# Optional proxy
# https_proxy=http://127.0.0.1:7897
# http_proxy=http://127.0.0.1:7897
# all_proxy=socks5://127.0.0.1:7897

# Supabase PostgreSQL pooler URI (recommended)
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
